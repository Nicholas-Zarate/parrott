{
  "name": "parrott-v2",
  "version": "0.0.1",
  "description": "Parrott Discord bot v2 — NestJS shell + Mastra core",
  "type": "module",
  "scripts": {
    "start:dev": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:dev:tsc": "node --env-file=.env node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:swc": "node_modules/@nestjs/cli/bin/nest.js build",
    "start": "node --env-file=.env dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepgram/sdk": "^3.13.0",
    "@discordjs/voice": "^0.19.2",
    "@elevenlabs/elevenlabs-js": "^2.52.0",
    "@mastra/core": "latest",
    "@mastra/memory": "latest",
    "@mastra/pg": "latest",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@ricky0123/vad-node": "^0.0.3",
    "@supabase/supabase-js": "^2.0.0",
    "discord.js": "^14.0.0",
    "ffmpeg-static": "^5.3.0",
    "necord": "^5.0.0",
    "onnxruntime-node": "^1.26.0",
    "openai": "^6.42.0",
    "opusscript": "^0.0.8",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/testing": "^10.0.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.41",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
