# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=                         # Bot token from Discord Developer Portal
                                       # Privileged intents required: Message Content, Presence, Guild Members

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=             # Service role key (RLS bypass — keep secret)

# ── Mastra / Postgres pooler ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Transaction pooler only — direct (IPv6) and session pooler (15-conn cap) don't work

# ── AI providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=                        # Model Router + embeddings (text-embedding-3-small) + Whisper STT
ANTHROPIC_API_KEY=                     # Optional — only if using anthropic/* models

# ── Voice (Task 5) ───────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                   # Optional — default voice
DEEPGRAM_API_KEY=                      # Streaming STT (Deepgram Nova-3)
PICOVOICE_ACCESS_KEY=                  # Local wake-word (Porcupine "parrot") — free tier

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001                              # HTTP control endpoint port (Task 7)
NODE_TLS_REJECT_UNAUTHORIZED=0         # Dev only — Supabase cert workaround
